# Local dev (docker-compose.yml): copy to .env, fill in the four queue URLs
# from `python -m scripts.bootstrap`, leave DATABASE_URL/REDIS_URL alone.
#
# EC2 (docker-compose.ec2.yml): copy to .env on the box, and additionally set
# DATABASE_URL (RDS Postgres, from DEPLOY.md §2), REDIS_URL (ElastiCache,
# from DEPLOY.md §3), and the three COGNITO_* values (from DEPLOY.md §8).
#
# No AWS access keys anywhere. Credentials come from the EC2 instance role /
# ECS task roles -- see DEPLOY.md.

ENV=local
LOG_LEVEL=INFO

# Local dev only. In AWS this becomes a real DATABASE_URL, e.g.
#   postgresql://edgentrag:<password>@<rds-endpoint>:5432/edgentrag
# (never postgres://  --  see shared/db.py::_driver for why that scheme fails
# at import).
DATABASE_URL=sqlite:////data/edgentrag.db
# Local dev only. In AWS this becomes the ElastiCache endpoint, with TLS:
#   rediss://<elasticache-endpoint>:6379/0
REDIS_URL=redis://redis:6379/0

S3_BUCKET=<your-s3-bucket>
AWS_REGION=us-east-1

# All four printed by `python -m scripts.bootstrap`. Prefixed edgentrag-v3-*,
# deliberately distinct from version 2's edgentrag-* queues -- see
# scripts/bootstrap.py.
INGEST_QUEUE_URL=
CHAT_QUEUE_URL=
STT_QUEUE_URL=
EMBED_QUEUE_URL=

# The one credential the GPU holds. Grants "ask the broker for a job" and
# nothing else.
#   openssl rand -hex 32
BROKER_TOKEN=

WEB_PORT=8080

EMBEDDING_SERVICE_URL=http://localhost:8001
STT_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003

# Cognito (new in v3). Leave all three blank to run with no auth gate --
# shared/auth.py falls back to that for local development. In AWS, fill these
# in from DEPLOY.md's Cognito section.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

CORS_ORIGINS=*
