# Copy to .env.local. No trailing slash.
#
# Locally this is the API on your own machine. In the built (production)
# image, VITE_API_BASE is /api instead -- see .env.production -- because
# nginx on the EC2 box serves both from one origin and CORS never comes into
# it.
VITE_API_BASE=http://localhost:8000

# Cognito (new in v3). Leave all three blank to run with no sign-in gate at
# all -- useful for local development against SQLite before a User Pool
# exists; shared/auth.py has the identical fallback on the backend, so the
# two sides agree without a separate "local mode" flag anywhere.
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
