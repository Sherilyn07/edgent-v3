# Used by `npm run build`, not by `npm run dev`.
#
# A RELATIVE path, deliberately. The built JavaScript runs in your visitor's
# browser, not on the server, so an absolute http://localhost:8000 would send
# them to their own laptop. "/api" resolves against whatever address the page
# was loaded from, so the same build works everywhere and never needs
# rebuilding when the address changes, and the browser never makes a
# cross-origin request -- CORS stops being something you have to think about.
VITE_API_BASE=/api

# Cognito (new in v3). These are baked into the built JavaScript at image-build
# time -- Vite has no server side to read them from later -- so fill them in
# here (from DEPLOY.md's Cognito section) BEFORE running
# `docker build -f frontend/Dockerfile .`. A User Pool id and an app client id
# are not secrets (the same values a browser would see in any Cognito Hosted
# UI redirect); nothing here is sensitive the way the pool's admin
# credentials would be.
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_2uivSAqhZ
VITE_COGNITO_APP_CLIENT_ID=622ntbu6tsln0tn19rpogq71bm
