# Settings for all three services. Each one reads what it recognises and
# ignores the rest. Copy to .env and edit — none of it is required, the
# defaults are sensible on both a laptop and an A100.

# --- where things run --------------------------------------------------------
# auto = cuda when a GPU is present, cpu otherwise. Force it if you want to
# prove to yourself that the GPU is actually being used.
DEVICE=auto

# --- embedding (8001) --------------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=64
MAX_LENGTH=256
# Where the vector database lives.
#
# DO NOT put this on Google Drive. Chroma is SQLite underneath, and Drive's
# FUSE layer cannot do the byte-range locking SQLite needs -- the first /embed
# fails with "database is locked" or "disk I/O error". launch.py detects this
# and moves it to local disk, but it is better not to ask.
#
# The index is disposable: re-uploading the documents rebuilds it. Losing it
# when the runtime is recycled is the expected behaviour, not a problem to fix.
CHROMA_DIR=/content/_chroma

# --- speech to text (8002) ---------------------------------------------------
# On an A100 there is no reason to stay on tiny.en. large-v3 is a different
# class of accuracy and still runs many times faster than real time.
WHISPER_MODEL=tiny.en
# auto = float16 on a GPU, int8 on a CPU
COMPUTE_TYPE=auto
MAX_SECONDS=1800
CHUNK_WORDS=200
CHUNK_OVERLAP_WORDS=40

# --- llm (8003) --------------------------------------------------------------
# TinyLlama barely touches an 80 GB card. Swap it and raise MAX_INPUT_TOKENS:
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct                (no licence gate)
#   LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct        (needs a HF token)
#   MAX_INPUT_TOKENS=8000
LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# auto = bfloat16 on a GPU, float32 on a CPU
DTYPE=auto
MAX_NEW_TOKENS=400
TEMPERATURE=0.3
MAX_INPUT_TOKENS=1600

# --- the broker --------------------------------------------------------------
# Where the backend is, and the token it gave us. Set both and the embedding
# and speech-to-text services start pulling queued jobs; leave them blank and
# they only answer HTTP calls, which is what you want when testing alone.
#
# BROKER_URL is the backend's public address with /api on the end -- the same
# https link you open in a browser. The token comes from the backend's .env.
#
# Notice what is NOT here: no AWS key, no bucket, no queue name. This token
# authorises "ask for a job" and nothing more.
# BROKER_URL=https://your-backend.trycloudflare.com/api
# BROKER_TOKEN=

# --- tunnels -----------------------------------------------------------------
# cloudflared (default, no account) | ngrok (needs NGROK_AUTHTOKEN) | none
# TUNNEL=cloudflared
# NGROK_AUTHTOKEN=
